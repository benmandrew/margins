+/// Render an atomic block that was replaced by one of the same sort.
+fn render_changed(old: &Block, new: &Block, out: &mut String) {
+    match (old, new) {
+        (Block::FuncCall { content: old_c }, Block::FuncCall { content: new_c }) => {
+            // Keep the old call as a comment for readers of the source, mark
+            // the change in the margin, then emit the new call unwrapped so
+            // its label and numbering keep working.
+            write_commented(old_c, out);
+            out.push('\n');
+            write_mark(DiffMark::Changed, new_c, out);
+            out.push_str(new_c);
+        }
+        _ => {
+            render_added_or_deleted(old, DiffTag::Deleted, out);
+            out.push_str("\n\n");
+            render_added_or_deleted(new, DiffTag::Added, out);
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+enum DiffMark {
+    Added,
+    Deleted,
+    Changed,
+}
