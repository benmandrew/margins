+/// Write code as `//` comments, without a trailing newline.
+fn write_commented(content: &str, out: &mut String) {
+    for line in content.lines() {
+        writeln!(out, "// {line}").unwrap();
+    }
+    if out.ends_with('\n') {
+        out.pop();
+    }
+}
