+/// Emit an unmatched stretch of a Replace region. Atomic blocks of the same
+/// sort (for example two `#figure` calls, or two display equations) are
+/// paired into `Changed`; everything else is `Deleted` or `Added`.
+fn emit_gap(old_gap: &[Block], new_gap: &[Block], results: &mut Vec<DiffResult>) {
+    let mut paired_new: Vec<Option<usize>> = vec![None; new_gap.len()];
