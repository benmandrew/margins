+/// A key that says which atomic blocks are "the same thing, changed".
+///
+/// - Display equations pair with display equations.
+/// - Raw blocks pair with raw blocks.
+/// - Function calls pair when they call the same function. For `#let`,
+///   `#set`, `#show`, `#import` and `#include`, the next word is part of the
+///   key, so `#let x = 1` pairs with `#let x = 2` but not with `#let y = 2`.
+fn atomic_key(block: &Block) -> Option<String> {
+    match block {
+        Block::Equation { .. } => Some("EQ".into()),
+        Block::RawBlock { .. } => Some("RAW".into()),
+        Block::FuncCall { content } => {
+            let body = content.strip_prefix('#').unwrap_or(content);
+            let ident = |s: &str| -> String {
+                s.chars()
+                    .take_while(|c| c.is_alphanumeric() || matches!(c, '-' | '_' | '.'))
+                    .collect()
+            };
+            let first = ident(body);
+            if first.is_empty() {
+                return None;
+            }
+            if matches!(
+                first.as_str(),
+                "let" | "set" | "show" | "import" | "include"
+            ) {
+                let rest = body[first.len()..].trim_start();
+                Some(format!("FC:{first} {}", ident(rest)))
+            } else {
+                Some(format!("FC:{first}"))
+            }
+        }
+        _ => None,
+    }
 }
 
