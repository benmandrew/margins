+/// Write a margin mark call for a function-call block, followed by a newline.
+fn write_mark(mark: DiffMark, content: &str, out: &mut String) {
+    let (func, verb) = match mark {
+        DiffMark::Added => ("diff-added-mark", "added"),
+        DiffMark::Deleted => ("diff-deleted-mark", "deleted"),
+        DiffMark::Changed => ("diff-changed-mark", "changed"),
+    };
+    let is_let = content
+        .strip_prefix("#let")
+        .is_some_and(|rest| rest.starts_with(char::is_whitespace));
+    if is_let {
+        writeln!(out, "#{func}(note: \"definition {verb}\")").unwrap();
+    } else {
+        writeln!(out, "#{func}()").unwrap();
+    }
+}
