+    /// Split a trailing `<label>` off `text`. Returns the text before the
+    /// label (trimmed at the end) and the label itself, including the angle
+    /// brackets. Returns `(text, None)` when there is no trailing label.
+    pub(crate) fn split_trailing(text: &str) -> (&str, Option<&str>) {
+        let trimmed = text.trim_end();
+        if trimmed.ends_with('>')
+            && let Some(start) = trimmed.rfind('<')
+            && Self::end(&trimmed[start..]) == Some(trimmed.len() - start)
+        {
+            let body = trimmed[..start].trim_end();
+            // Only treat it as a label when something precedes it, so a
+            // bare label stays a label-only paragraph.
+            if !body.is_empty() {
+                return (body, Some(&trimmed[start..]));
+            }
+        }
+        (text, None)
+    }
 }
 
