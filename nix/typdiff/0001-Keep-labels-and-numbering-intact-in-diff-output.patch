+/// Attach `label` to the last block when that block can carry a label.
+/// Returns false when there is no such block (for example after a paragraph
+/// break), so the caller keeps the label as its own block.
+fn attach_label(blocks: &mut [Block], label: &str) -> bool {
+    match blocks.last_mut() {
+        Some(Block::Equation { content, .. })
+        | Some(Block::FuncCall { content })
+        | Some(Block::RawBlock { content }) => {
+            content.push(' ');
+            content.push_str(label);
+            true
+        }
+        Some(Block::Heading { body_text, .. }) => {
+            body_text.push(' ');
+            body_text.push_str(label);
+            true
+        }
+        _ => false,
+    }
+}
